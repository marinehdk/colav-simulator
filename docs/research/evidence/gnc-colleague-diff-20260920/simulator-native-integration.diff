+            and ahead >= FIRST_CHANGE_GATE_M
+            and math.isfinite(lateral)
+            and lateral <= MAX_LATERAL_M
+            and not has_reverse_segment(points)
+            and float(gaps.min()) >= SEGMENT_FLOOR_M
